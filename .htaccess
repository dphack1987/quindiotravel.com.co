# Performance Optimization
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Brotli Compression (mejor que Gzip: 15-20% más reducción)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml application/manifest+json font/woff2
</IfModule>

# Gzip Compression (fallback si Brotli no disponible)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Browser Caching (unificado: 1 año para assets, sin conflicto)
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|css|js|woff2|woff|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; frame-src https://www.youtube.com"
</IfModule>

# Force HTTPS (combined with WWW removal in single redirect)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*)$ https://quindiotravel.com.co/$1 [L,R=301]
</IfModule>

# Redirect /blog/ and /planes/ to .html versions (FIX 404 GSC)
<IfModule mod_rewrite.c>
    RewriteRule ^blog/?$ /blog.html [R=301,L]
    RewriteRule ^planes/?$ /planes.html [R=301,L]
</IfModule>

# Remove Trailing Slash
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]
</IfModule>

# Redirect pSEO 404 URLs - Municipios (e.g., /armenia/viajes-economicos → /armenia.html)
<IfModule mod_rewrite.c>
    RewriteRule ^armenia/(.+)$ /armenia.html [R=301,L]
    RewriteRule ^salento/(.+)$ /salento.html [R=301,L]
    RewriteRule ^filandia/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^buenavista/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^montengro/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^circasia/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^quimbaya/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^giroidionisio/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^calarca/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^tebaida/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^pijao/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^bugalagrande/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^la-tebaida/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^cupica/(.+)$ /filandia.html [R=301,L]
    RewriteRule ^urrao/(.+)$ /filandia.html [R=301,L]
</IfModule>

# Redirect pSEO 404 URLs - Tipos de viaje (e.g., /viajes/viajes-culturales → /planes.html)
<IfModule mod_rewrite.c>
    RewriteRule ^viajes/(.+)$ /planes.html [R=301,L]
</IfModule>

# Redirect pSEO 404 URLs - Alojamientos (e.g., /alojamiento/jacuzzi → /alojamientos.html)
<IfModule mod_rewrite.c>
    RewriteRule ^alojamiento/(.+)$ /alojamientos.html [R=301,L]
</IfModule>

# Redirect pSEO 404 URLs - Atractivos (e.g., /atractivos/panaca → /panaca.html)
<IfModule mod_rewrite.c>
    RewriteRule ^atractivos/panaca$ /panaca.html [R=301,L]
    RewriteRule ^atractivos/termales-santa-rosa$ /termales-santa-rosa.html [R=301,L]
    RewriteRule ^atractivos/recuca$ /recuca.html [R=301,L]
    RewriteRule ^atractivos/parque-del-cafe$ /parque-del-cafe.html [R=301,L]
    RewriteRule ^atractivos/mariposario-quindio$ /mariposario-quindio.html [R=301,L]
    RewriteRule ^atractivos/granja-mama-lulu$ /granja-mama-lulu.html [R=301,L]
    RewriteRule ^atractivos/parque-los-arrieros$ /parque-los-arrieros.html [R=301,L]
    RewriteRule ^atractivos/laberinto-mil-caminos$ /laberinto-mil-caminos.html [R=301,L]
    RewriteRule ^atractivos/(.+)$ /experiencias.html [R=301,L]
</IfModule>

# Redirect pSEO 404 URLs - Blog (e.g., /blog/viajes-bienestar-2026.html → /blog.html)
<IfModule mod_rewrite.c>
    RewriteRule ^blog/viajes-(.+)$ /blog.html [R=301,L]
</IfModule>

# Redirect generated-pages and programmatic-pages to homepage
<IfModule mod_rewrite.c>
    RewriteRule ^generated-pages/(.+)$ / [R=301,L]
    RewriteRule ^programmatic-pages/(.+)$ / [R=301,L]
</IfModule>

# Redirect duplicate "mejor época" pages to primary blog post
<IfModule mod_rewrite.c>
    RewriteRule ^mejor-epoca-para-visitar-quindio\.html$ /blog/mejor-epoca-visitar-quindio-2026.html [R=301,L]
    RewriteRule ^blog-mejor-epoca-eje-cafetero\.html$ /blog/mejor-epoca-visitar-quindio-2026.html [R=301,L]
    RewriteRule ^blog/mejor-epoca-para-visitar-quindio-en-2026-guia-completa\.html$ /blog/mejor-epoca-visitar-quindio-2026.html [R=301,L]
</IfModule>

# Redirect duplicate "planes turísticos" thin pages to primary
<IfModule mod_rewrite.c>
    RewriteRule ^viajes-economicos-quindio\.html$ /precios-planes-turisticos-quindio.html [R=301,L]
    RewriteRule ^quindio-viajes-planes-turisticos\.html$ /precios-planes-turisticos-quindio.html [R=301,L]
</IfModule>

# Redirect duplicate "turismo familiar" to primary
<IfModule mod_rewrite.c>
    RewriteRule ^turismo-familiar-eje-cafetero\.html$ /planes-familiares-quindio.html [R=301,L]
</IfModule>

# Protect Files
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak|sql|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Custom Error Pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
